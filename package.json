{
  "name": "campusfix",
  "version": "0.5.0",
  "description": "CampusFix final VE3 React portfolio \u2014 authorized live maintenance workflows",
  "scripts": {
    "dev": "npm run build:web && node --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "check": "npm run check:backend && tsc -p web/tsconfig.json",
    "build": "tsc && npm run build:web",
    "test": "vitest run",
    "format": "prettier --write src tests scripts docs web e2e *.md *.config.ts eslint.config.js",
    "setup": "node --import tsx scripts/setup.ts",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "doctor": "node --env-file=.env --import tsx scripts/doctor.ts",
    "test:integration": "node --env-file=.env --import tsx scripts/test-native.ts",
    "test:embedded": "vitest run tests/integration.test.ts tests/workflow-api.test.ts",
    "test:unit": "vitest run tests/app.test.ts tests/workflow.test.ts tests/config.test.ts",
    "db:test:prepare": "node --env-file=.env --import tsx scripts/prepare-test-db.ts",
    "format:check": "prettier --check src tests scripts docs web e2e *.md *.config.ts eslint.config.js",
    "check:backend": "tsc --noEmit",
    "build:web": "vite build",
    "watch:web": "vite build --watch",
    "test:frontend": "vitest run --config vitest.web.config.ts",
    "test:all": "npm test && npm run test:frontend",
    "lint": "eslint src scripts tests web/src web/tests e2e *.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:native": "node --env-file=.env --import tsx scripts/e2e-native.ts",
    "test:e2e:realtime": "playwright test --config playwright.realtime.config.ts",
    "test:realtime": "vitest run tests/workflow-api.test.ts -t Socket.IO",
    "test:frontend:serial": "vitest run --config vitest.web.config.ts --maxWorkers=1 --no-file-parallelism",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "verify:disposable": "node scripts/verify-disposable.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "cookie": "2.0.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
